# Server-only. Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard > Project Settings > API > service_role key. Tables have RLS on with no policies,
# so this key (used only on the server, after login) is the only way in.
SUPABASE_SERVICE_ROLE_KEY=

# The single password for signing in.
APP_PASSWORD=
# 32+ random characters; signs the login cookie and the calendar feed link. Generate: openssl rand -base64 48
SESSION_SECRET=
